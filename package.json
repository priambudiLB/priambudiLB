{
  "name": "fyi",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "NO_UPDATE_NOTIFIER=1 docusaurus",
    "start": "NO_UPDATE_NOTIFIER=1 docusaurus start",
    "build": "NO_UPDATE_NOTIFIER=1 docusaurus build",
    "swizzle": "NO_UPDATE_NOTIFIER=1 docusaurus swizzle",
    "deploy": "NO_UPDATE_NOTIFIER=1 docusaurus deploy",
    "clear": "NO_UPDATE_NOTIFIER=1 docusaurus clear",
    "serve": "NO_UPDATE_NOTIFIER=1 docusaurus serve",
    "write-translations": "NO_UPDATE_NOTIFIER=1 docusaurus write-translations",
