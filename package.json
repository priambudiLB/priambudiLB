    "@tippyjs/react": "^4.2.6",
    "clsx": "^2.1.1",
    "file-loader": "^6.2.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-icons": "^5.5.0",
    "tippy.js": "^6.3.7",
    "url-loader": "^4.1.1"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
